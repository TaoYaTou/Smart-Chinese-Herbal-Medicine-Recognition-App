page {
  background: #f5f8fa;
  font-family: -apple-system, sans-serif;
}

.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 0 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}


.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  min-height: 88rpx;
  gap: 300rpx;
}


.item-title {
  font-size: 30rpx;
  color: #1a2a3a;
  font-weight: 500;
  flex-shrink: 0;
  white-space: nowrap;
}


.setting-item switch {
  flex-shrink: 0;
}


.action-btn {
  flex-shrink: 0;
  padding: 8rpx 32rpx;
  border-radius: 30rpx;
  background: #f0f0f0;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 42rpx;
  min-height: 55rpx;
}

.setting-item:active .action-btn {
  background: #e0e0e0;
}

.clear-text {
  font-size: 26rpx;
  color: #2d8a4e;
  font-weight: 500;
}

.loading-btn {
  background: #e8f5e9;
}


.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #c8e6c9;
  border-top-color: #2d8a4e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 0 0 0 72rpx;
}
