page {
  background: #f5f8fa;
  font-family: -apple-system, sans-serif;
}

.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section {
  display: flex;
  flex-direction: column;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 28rpx 0;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a2a3a;
  display: block;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #6b7a8a;
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  transition: all 0.25s ease;
}
.contact-item:active {
  transform: scale(0.97);
  background: #f0f2f5;
}
.contact-item .icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.contact-item .label {
  font-size: 28rpx;
  color: #6b7a8a;
  width: 80rpx;
}
.contact-item .value {
  font-size: 28rpx;
  color: #1a2a3a;
  font-weight: 500;
  flex: 1;
}

.copy-btn {
  font-size: 32rpx;
  color: #2d8a4e;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #e8f5e9;
  transition: all 0.2s ease;
}
.copy-btn:active {
  transform: scale(0.9);
  opacity: 0.7;
}

.link {
  font-size: 28rpx;
  color: #2d8a4e;
  display: block;
  margin-top: 16rpx;
  text-decoration: underline;
}

.footnote {
  font-size: 24rpx;
  color: #b0bec5;
  display: block;
  margin-top: 16rpx;
}