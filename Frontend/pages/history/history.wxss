.container {
  padding: 30rpx 32rpx;
  background: #f5f8fa;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.fixed-header {
  flex-shrink: 0;
}

.header {
  margin-bottom: 0;
  text-align: center;
  width: 100%;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a2a3a;
  display: inline-block;
}

.tab-bar {
  display: flex;
  background: #f0f2f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  gap: 8rpx;
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #6b7a8a;
  border-radius: 10rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #fff;
  color: #2d8a4e;
  box-shadow: 0 2rpx 12rpx rgba(45, 138, 78, 0.15);
  transform: scale(1.02);
}

.scroll-content {
  flex: 1;
  overflow-y: auto;
  padding-bottom: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #f0f2f5;
  transition: all 0.3s ease;
}

.search-box:focus-within {
  border-color: #2d8a4e;
  box-shadow: 0 2rpx 16rpx rgba(45, 138, 78, 0.12);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  color: #b0bec5;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a2a3a;
  background: transparent;
  border: none;
  outline: none;
}

.search-placeholder {
  color: #b0bec5;
  font-size: 28rpx;
}

.fade-in-up {
  animation: fadeInUp 0.4s ease-out both;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: all 0.25s ease;
}

.history-item:active {
  transform: scale(0.97);
  background: #f0f2f5;
}

.item-left {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.item-image {
  width: 100%;
  height: 100%;
}

.item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.item-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #2d8a4e;
}

.item-confidence {
  font-size: 24rpx;
  color: #6b7a8a;
  margin-top: 4rpx;
}

.item-time {
  font-size: 22rpx;
  color: #b0bec5;
  margin-top: 6rpx;
}

.herbarium-stats {
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stats-text {
  font-size: 26rpx;
  color: #6b7a8a;
}

.stats-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d8a4e;
}

.stats-progress {
  margin-top: 10rpx;
  width: 100%;
}

.herbarium-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.herbarium-card {
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.herbarium-card:active {
  transform: scale(0.96);
}

.herbarium-image-wrapper {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: #f5f6fa;
  overflow: hidden;
}

.herbarium-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.herbarium-status {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.herbarium-status.discovered {
  background: rgba(45, 138, 78, 0.9);
  color: #fff;
}

.herbarium-status.undiscovered {
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
}

.herbarium-info {
  padding: 12rpx 14rpx;
}

.herbarium-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a2a3a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.herbarium-scientific {
  display: block;
  font-size: 20rpx;
  color: #b0bec5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.herbarium-card.undiscovered .herbarium-image-wrapper {
  filter: grayscale(0.8);
  opacity: 0.7;
}

.herbarium-card.undiscovered .herbarium-name {
  color: #b0bec5;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 200rpx;
}

.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 32rpx; color: #6b7a8a; margin-top: 20rpx; }
.empty-hint { font-size: 26rpx; color: #b0bec5; margin-top: 10rpx; }

.tap-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 20rpx 0;
  gap: 8rpx;
}

.hint-icon { font-size: 28rpx; color: #2d8a4e; }
.hint-text { font-size: 30rpx; color: #6b7a8a; }

.item-image,
.herbarium-image {
  transition: opacity 0.4s ease;
}