.container {
  padding: 30rpx 32rpx;
  background: #f5f8fa;
  min-height: 100vh;
}
.header {
  margin-bottom: 30rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a2a3a;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.history-item {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.item-left {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.item-image {
  width: 100%;
  height: 100%;
}
.item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.item-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #2d8a4e;
}
.item-confidence {
  font-size: 24rpx;
  color: #6b7a8a;
  margin-top: 4rpx;
}
.item-time {
  font-size: 22rpx;
  color: #b0bec5;
  margin-top: 6rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 200rpx;
}
.empty-icon {
  font-size: 80rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #6b7a8a;
  margin-top: 20rpx;
}
.empty-hint {
  font-size: 26rpx;
  color: #b0bec5;
  margin-top: 10rpx;
}
.tap-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 20rpx 0;
  gap: 8rpx;
}
.hint-icon {
  font-size: 28rpx;
  color: #2d8a4e;
}
.hint-text {
  font-size: 30rpx;
  color: #6b7a8a;
}